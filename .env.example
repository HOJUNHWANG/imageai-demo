# Copy to .env and edit (do NOT commit your real ADMIN_TOKEN)

# Public demo safety mode
PUBLIC_DEMO=1

# Enable private/internal modes (still locked behind admin token in PUBLIC_DEMO)
ENABLE_PRIVATE_MODES=0

# Admin unlock token for private modes (set a long random string)
# Example (generate): python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Mock mode (no model load)
MOCK_INPAINT=0
