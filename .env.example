# Public demo safety mode
PUBLIC_DEMO=1

# Public guardrails (defaults shown)
PUBLIC_MAX_LONG_SIDE=896
PUBLIC_MAX_STEPS=22
PUBLIC_MAX_QUEUE=10
PUBLIC_CONCURRENCY=1

# Mock mode (no model load)
MOCK_INPAINT=0

# Debug only
DEBUG_CUDA=0
