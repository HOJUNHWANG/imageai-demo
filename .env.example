# Copy to .env and edit.
# NOTE: Do not commit your real secrets/tokens.

# ── Server ────────────────────────────────────────────────────────────────────

# CORS whitelist (comma-separated). Add your frontend origin here.
# Example: http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Public demo guardrails ────────────────────────────────────────────────────

# Set PUBLIC_DEMO=1 to enforce safe limits below
PUBLIC_DEMO=1
PUBLIC_MAX_LONG_SIDE=896
PUBLIC_MAX_STEPS=22
PUBLIC_MAX_QUEUE=10
PUBLIC_CONCURRENCY=1

# ── Model / inference ────────────────────────────────────────────────────────

# Set MOCK_INPAINT=1 during development to skip model loading
MOCK_INPAINT=0

# VRAM stability toggles
LOW_VRAM=1
CPU_OFFLOAD=0
AUTO_UNLOAD_AUX=1

# torch.compile for SDXL UNet — 20-40% speedup after first run.
# WARNING: Adds 60-120s compilation time on first load. Requires PyTorch 2.0+.
COMPILE_UNET=0

# ── Debug ─────────────────────────────────────────────────────────────────────

DEBUG_CUDA=0
# LOG_LEVEL controls Python logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
