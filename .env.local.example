# Hugging Face access token. Required for Quality generation and the sensitive
# Balanced generation repository after accepting each model's access terms.
HF_TOKEN=

# Every profile can point to a compatible local folder or Hugging Face repo.
GENERATE_QUALITY_MODEL=kpsss34/FHDR_Uncensored
GENERATE_BALANCED_MODEL=Bl4ckSpaces/z-image-turbo-nsfw-nf4
GENERATE_FAST_MODEL=KaraKaraWitch/Z-Image-Turbo-TE-Heretic

EDIT_BASE_MODEL=Qwen/Qwen-Image-Edit-2511
EDIT_BALANCED_LORA=lightx2v/Qwen-Image-Edit-2511-Lightning
EDIT_FAST_TRANSFORMER=prithivMLmods/Qwen-Image-Edit-Rapid-AIO-V23

# RTX 3080 Ti defaults. Text-encoder quantization substantially reduces PCIe
# transfer and prevents the Qwen/FLUX encoders from exceeding 12 GB VRAM.
DEFAULT_PROFILE=balanced
ENABLE_4BIT=1
QUANTIZE_TEXT_ENCODERS=1
CPU_OFFLOAD=1
# Benchmarked 21–30% faster than native SDPA for long image-attention sequences
# on the RTX 3080 Ti. Set to native if troubleshooting.
ATTENTION_BACKEND=xformers
LOCAL_FILES_ONLY=0

MAX_UPLOAD_MB=32
MAX_LONG_SIDE=1280
MAX_PIXELS=1048576
