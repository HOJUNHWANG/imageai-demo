# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never committed.

# ─── CivitAI API Key ──────────────────────────────────────────────────────────
# Required for downloading test models via scripts/download_test_models.py
# Get yours at: https://civitai.com/user/account → API Keys
CIVITAI_API_KEY=

# ─── Test Model Slots ─────────────────────────────────────────────────────────
# Set absolute paths to local .safetensors files.
# Run `python scripts/download_test_models.py` to auto-populate these.
# Leave blank to hide the slot from the UI.
TEST_MODEL_1=
TEST_MODEL_2=
TEST_MODEL_3=
TEST_MODEL_4=
